<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HttpTests.fs" />
    <Compile Include="AuthHttpTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App\App.fsproj" />
    <ProjectReference Include="..\..\src\App.Database\App.Database.fsproj" />
    <ProjectReference Include="..\..\src\App.Domain\App.Domain.fsproj" />
    <ProjectReference Include="..\App.Testing\App.Testing.fsproj" />
  </ItemGroup>

</Project>
