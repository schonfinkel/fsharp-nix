<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FsToolkit.ErrorHandling" Version="4.18.0" />
    <PackageReference Include="FsToolkit.ErrorHandling.TaskResult" Version="4.18.0" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.5.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Oxpecker" Version="2.1.1" />
    <PackageReference Include="Oxpecker.Htmx" Version="4.0.0" />
    <PackageReference Include="Oxpecker.ViewEngine" Version="2.1.0" />
    <PackageReference Include="SqlHydra.Query" Version="3.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\App.Migrations\App.Migrations.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Database.Generated.fs" />
    <Compile Include="FeatureFlags.fs" />
    <Compile Include="IdentityStore.fs" />
    <Compile Include="Demo.fs" />
    <Compile Include="Account.fs" />
    <Compile Include="Bootstrap.fs" />
    <Compile Include="Admin.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
